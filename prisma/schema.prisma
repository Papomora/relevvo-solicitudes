generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClientePin {
  id          Int    @id @default(autoincrement())
  cliente     String @unique
  pin         String
  presupuesto Int?
}

model Integrante {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  phone  String?
}

model Solicitud {
  id                 Int       @id @default(autoincrement())
  cliente            String
  tipo               String
  urgencia           String
  descripcion        String
  estado             String    @default("pendiente")
  nota               String?
  perfil             String?
  asignado           String?
  adjuntos           Json      @default("[]")
  archivado          Boolean   @default(false)
  ultimoRecordatorio DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ── Rate limiting ─────────────────────────────────────────────
model RateLimit {
  id      Int      @id @default(autoincrement())
  key     String   @unique   // e.g. "pin:1.2.3.4"
  count   Int      @default(0)
  resetAt DateTime
}

// ── WhatsApp Agent ───────────────────────────────────────────
model ClienteWA {
  id            Int       @id @default(autoincrement())
  phone         String    @unique   // +573001234567
  nombre        String              // debe coincidir con Solicitud.cliente
  activo        Boolean   @default(true)
  limiteMes     Int       @default(10)
  ultimoCheckIn DateTime?
  createdAt     DateTime  @default(now())
}

model ProspectoSession {
  id            Int      @id @default(autoincrement())
  phone         String   @unique
  historial     Json     @default("[]")
  estado        String   @default("activo")  // activo | completado | cancelado
  brief         String?
  ultimoMensaje DateTime @default(now())
  createdAt     DateTime @default(now())
}

model WaSession {
  id            Int      @id @default(autoincrement())
  phone         String   @unique
  cliente       String   @default("")
  historial     Json     @default("[]")   // [{ role, content }]
  ultimoMensaje DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
